{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.unity/unity-cli",
  "title": "Unity CLI MCP",
  "description": "MCP server built into the Unity CLI for automating and controlling Unity projects.",
  "version": "0.1.0-beta.8",
  "websiteUrl": "https://docs.unity.com/en-us/cli",
  "repository": {
    "url": "https://github.com/Unity-Technologies/skills",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "binary",
      "identifier": "unity",
      "version": "0.1.0-beta.8",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "unity",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--project-path",
          "valueHint": "UNITY_PROJECT_PATH"
        }
      ]
    }
  ],
  "_meta": {
    "com.yourcompany.registry": {
      "install": {
        "command": "unity",
        "arguments": [
          "mcp",
          "--project-path",
          "{UNITY_PROJECT_PATH}"
        ]
      }
    }
  }
}